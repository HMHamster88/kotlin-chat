# Gradle and build output
.gradle/
build/
**/build/
.kotlin/
out/

# Local server state: verifier, TLS key store, created rooms, pinned keys.
# Everything here is generated by `server.bat init` and must never be committed.
/config/
/integration/config/

# Key material, wherever it turns up, apart from the Android debug key: that one is public by
# design (the SDK ships an equivalent) and keeping one key makes sideloaded APKs update in place.
*.p12
*.pfx
*.jks
*.keystore
!app-android/debug.keystore

# Machine-specific tooling
local.properties
.idea/
*.iml
.vscode/
.fleet/
.DS_Store

# Logs and crash dumps
*.log
logs/
hs_err_pid*
*.hprof

# Local compose settings (CHAT_PASSWORD)
.env
.image/
